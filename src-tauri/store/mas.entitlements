<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store: Sandbox. Nur für eine eigene MAS-Variante (tauri.mas.conf.json); der direkte,
     notarisierte Download bleibt ohne Sandbox. Was in der Sandbox nicht geht: docs/app-store.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Verbindungen zu RDP, VNC, SSH, FTP -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lokale Ports für SSH-Tunnel und Türöffner (nur 127.0.0.1) -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Dateifenster, Hoch- und Herunterladen: nur vom Nutzer gewählte Dateien und Downloads -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
