{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sesam Remote",
  "version": "26.11.2",
  "identifier": "ch.sesam.remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Sesam Remote",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: sfsymbol:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "category": "Utility",
    "shortDescription": "Bildschirm, Shell und Dateien entfernter Rechner in einer App",
    "longDescription": "Sesam Remote verbindet sich mit Rechnern per RDP, VNC, SSH, SFTP und FTP: Desktop, Shell und Dateien in einer App, mit Zugangsdaten im Schlüsselbund des Systems.",
    "resources": {
      "../LICENSE": "lizenzen/LICENSE.txt",
      "../docs/lizenzen/Inter-OFL.txt": "lizenzen/Inter-OFL.txt",
      "../docs/lizenzen/JetBrainsMono-OFL.txt": "lizenzen/JetBrainsMono-OFL.txt",
      "../docs/lizenzen/FluentSystemIcons-MIT.txt": "lizenzen/FluentSystemIcons-MIT.txt"
    },
    "publisher": "Sesam Remote",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "26F306D2-BA30-5F9C-B735-610DBA9E864E",
        "language": [
          "de-DE"
        ],
        "fragmentPaths": [
          "wix/autoupdate.wxs"
        ],
        "componentRefs": [
          "AutoUpdatePolicy"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sesam"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "sesam"
          ],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMEE0MTFCMkE1MDk1OUMKUldTY2xWQXFHMEVLcjgvVkFlT21xbU8xUTRhc1gwWFppRWF0V1J2L1RScHFZN1QyRmZUaGRjL2UK",
      "endpoints": [
        "https://sesam-remote.app/updates/latest.json",
        "https://github.com/MiDo1412/sesam-remote/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
