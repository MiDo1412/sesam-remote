<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hauptsprache Deutsch, dazu Englisch (src/i18n.ts) -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
	<!-- Text der macOS-Abfrage «Lokales Netzwerk» (Tauri übernimmt diese Datei ins App-Bundle) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sesam verbindet sich mit Rechnern in deinem Netzwerk (SSH, RDP, VNC und Dateien).</string>
</dict>
</plist>
